<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="loki-checkout.shipping.address.street0">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Street Name</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.street1">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Housenumber</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.street2">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Addition</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.postcode">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Postal code</argument>
                <argument name="placeholder" xsi:type="string">1234</argument>
                <argument name="field_attributes" xsi:type="array">
                    <item name="x-mask" xsi:type="string">9999</item>
                </argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.region">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">State</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.street0">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Street Name</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.street1">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Housenumber</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.street2">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Addition</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.postcode">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Postcode</argument>
                <argument name="placeholder" xsi:type="string">1234</argument>
                <argument name="field_attributes" xsi:type="array">
                    <item name="x-mask" xsi:type="string">9999</item>
                </argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.region">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">State</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
